{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WindowsNotch",
  "version": "0.1.0",
  "identifier": "fr.nayxyann.windowsnotch",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "WindowsNotch",
        "width": 420,
        "height": 46,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "center": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": false,
    "windows": {
      "nsis": {
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "PUBLIC_KEY_TO_BE_ADDED_BEFORE_FIRST_RELEASE",
      "endpoints": [
        "https://github.com/NayxYann/WindowsNotch/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}